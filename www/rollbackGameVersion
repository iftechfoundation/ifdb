<?php

include_once "session-start.php";
include_once "pagetpl.php";
include_once "util.php";
include "starctl.php";
include_once "editgame-util.php";

include_once "login-check.php";
if (!logged_in())
    exit();

$userid = $_SESSION['logged_in_as'];

include_once "dbconnect.php";
$db = dbConnect();

// can't be a troll, an unapproved new user, a banned user, or a closed account
if (!check_editing_privileges($db))
    exit();

// check for admin privileges (for diagnostic error detail)
$result = mysqli_execute_query($db,
    "select `privileges` from users where id = ?", [$userid]);
$adminPriv =
    $result
    && strpos(mysql_result($result, 0, "privileges"), "A") !== false;

$gameid = get_req_data("game");
$version = get_req_data("version");

function showResult($title, $msg, $gameid)
{
    pageHeader($title);
    echo "<h1>{$title}</h1>"
        . "<p>{$msg}</p>"
        . "<p><a href=\"viewgame?id=" . htmlspecialchars($gameid)
        . "&amp;history\">Return to update history</a></p>";
    pageFooter();
    exit();
}

if ($gameid == "" || $version == "") {
    showResult("Missing parameters",
               "A game ID and version number are required.",
               $gameid);
}

// look up the game
$result = mysqli_execute_query($db,
    "select title, pagevsn from games where id = ?", [$gameid]);
if (!$result || mysql_num_rows($result) == 0)
    showResult("Game not found",
               "The specified game wasn't found in the database.",
               $gameid);

$title = htmlspecialchars(mysql_result($result, 0, "title"));
$currentVsn = (int)mysql_result($result, 0, "pagevsn");
$targVsn = (int)$version;

if ($targVsn < 1 || $targVsn > $currentVsn) {
    showResult("Version not found",
               "Version {$targVsn} of this game wasn't found.",
               $gameid);
}

if ($targVsn == $currentVsn) {
    showResult("Already current",
               "Version {$targVsn} is already the current version of "
               . "<i>{$title}</i>. There's nothing to roll back.",
               $gameid);
}

// confirm before rolling back
if (!isset($_REQUEST['confirm'])) {
    pageHeader("Roll Back Game Version");
    echo "<h1>Roll Back Game Version</h1>"
        . "<p>Create a new version of <i>{$title}</i> that restores "
        . "the listing to how it looked in version {$targVsn}?</p>"
        . "<p>The current version (v.{$currentVsn}) and all other "
        . "history will be preserved. This is equivalent to manually "
        . "re-entering the older data and saving.</p>"
        . "<p><a href=\"rollbackGameVersion?game="
        . urlencode($gameid) . "&amp;version={$targVsn}&amp;confirm\">"
        . "Yes, roll back to version {$targVsn}</a></p>"
        . "<p><a href=\"viewgame?id=" . urlencode($gameid)
        . "&amp;history\">Cancel</a></p>";
    pageFooter();
    exit();
}

// reconstruct the requested historical version as an edit request
[$req, $errMsg] = loadGameRecordAtVersion($db, $gameid, $targVsn);
if (!$req) {
    showResult("Error loading version",
               $errMsg ? $errMsg : "Unable to load the requested version.",
               $gameid);
}

// save as a new version on top of the current listing.
// Use API mode so saveUpdates returns instead of redirecting, and we
// can send the user back to the update-history view.
$rec = [];
$saveErrMsg = false;
$saveErrCode = false;
$errDetail = [];
$result = saveUpdates($db, $adminPriv, true,
                      $gameid, $rec, $req,
                      $saveErrMsg, $saveErrCode, $errDetail);

if (!$result) {
    $detail = $saveErrMsg ? $saveErrMsg : "The rollback could not be saved.";
    if ($adminPriv && $saveErrCode)
        $detail .= " (code: " . htmlspecialchars($saveErrCode) . ")";
    if (count($errDetail)) {
        $detail .= "<ul>";
        foreach ($errDetail as $field => $msgs) {
            foreach ($msgs as $m)
                $detail .= "<li>" . htmlspecialchars($field) . ": "
                    . $m . "</li>";
        }
        $detail .= "</ul>";
    }
    showResult("Error saving rollback", $detail, $gameid);
}

// success - send them to the update history for the game
$redir = "viewgame?id=" . urlencode($gameid) . "&history";
header("HTTP/1.1 303 See Other");
header("Content-Type: text/html");
header("Location: $redir");
echo "<a href=\"" . htmlspecialchars($redir) . "\">Redirecting
    (click here if your browser doesn't redirect
     automatically)</a>";
exit();
?>
