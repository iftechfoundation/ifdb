                       GIF format, 40x40 pixels, transparent background)
                 </td>
              </tr>

              <?php
if ($osid == "new" || $osid != 0) {
              ?>
              <tr><td>&nbsp;<br></td></tr>
              <tr valign=top>
                 <td align=right>
                    Versions:
                 </td>
                 <td>

<style nonce="<?php global $nonce; echo $nonce; ?>">
