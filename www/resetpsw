<?php

include_once "pagetpl.php";
include_once "dbconnect.php";

include_once "session-start.php";
include_once "password-login.php";

// read the activation code
$errFlagged = false;
$activated = false;
$showForm = true;
$actcode = $_REQUEST['a'] ?? '';
$email = $_REQUEST['userid'] ?? '';
$psw = $_REQUEST['password'] ?? '';
$psw2 = $_REQUEST['password2'] ?? '';

// verifier function
function verify() {
    global $actcode, $activated, $errFlagged, $showForm, $email, $psw, $psw2;

    // connect to the database
    $db = dbConnect();
    if ($db == false) {
        $errFlagged = "An error occurred accessing the user database. Please
            try again. If the problem persists, please
            <a href='/contact'>contact us</a> to let us know about the
            problem.";
        return true;
    }

    // look up the activation code
    $qcode = mysql_real_escape_string($actcode, $db);
    $result = mysql_query("select id, email, acctstatus,
            resetexpires > now() as unexpired
        from users where activationcode = '$qcode'", $db);
    if (mysql_num_rows($result) == 0) {
        // the activation code doesn't exist
        $errFlagged = "This password reset link isn't valid. Please check
            that you copied the link correctly from your password reset
            email. Reset links work only once, and if you requested more
            than one reset, only the link in the most recent email works.
            To get a new link, <a href=\"lostpass\">request another
            reset</a>.";
        $showForm = false;
        return true;
    }
    if (!mysql_result($result, 0, "unexpired")) {
        $errFlagged = "This password reset link has expired. Reset links
            work for 24 hours. To get a new link,
            <a href=\"lostpass\">request another reset</a>.";
        $showForm = false;
        return true;
    }

    // get the user ID number, stored email address, and activation status
    $usernum = mysql_result($result, 0, "id");
    $dbemail = mysql_result($result, 0, "email");
    $acctstatus = mysql_result($result, 0, "acctstatus");

    // check for review needed
    if ($acctstatus == 'R') {
        $errFlagged = "This account is still pending review.";
        $showForm = false;
        return true;
    }

    // check for updates
    if ($_SERVER['REQUEST_METHOD'] == 'POST'
        && (strlen($email) != 0 || strlen($psw) != 0 || strlen($psw2) != 0)) {
        // validate the user ID
        if (strcasecmp($email, $dbemail) != 0) {
            $errFlagged = "Incorrect email address - you must enter your
                registered email address to confirm your identity.";
            return true;
        }

        // validate the password
        $errFlagged = new_password_error($psw, $psw2);
        if ($errFlagged)
            return true;

        $failed = false;
        $pswhash = with_transaction($db, function ($db)
            use ($usernum, $actcode, $acctstatus, $psw, &$failed) {
            // reset codes are one-time-only, so claim this one
            mysqli_execute_query($db,
                "update users set activationcode = ?
                 where id = ? and activationcode = ? and resetexpires > now()",
                [random_token(), $usernum, $actcode]);
            if (mysqli_affected_rows($db) != 1) {
                $failed = 'claim';
                return false;
            }

            // activate now, if needed
            if ($acctstatus == 'D'
                && !mysql_query("update users set acctstatus = 'A'
                    where id = '$usernum'", $db)) {
                $failed = 'activate';
                return false;
            }

            $pswhash = set_password($db, $usernum, $psw);
            if (!$pswhash)
                return false;
            return mysqli_execute_query($db,
                "update users set resetexpires = null where id = ?",
                [$usernum]) ? $pswhash : false;
        });
        if ($failed == 'claim') {
            $errFlagged = "This password reset link is no longer valid.
                Please <a href=\"lostpass\">request another reset</a>.";
            $showForm = false;
            return true;
        }
        if ($failed == 'activate') {
            $errFlagged = "An error occurred updating the user database to
                activate your account. Please try again. If the problem
                persists, please <a href='/contact'>contact us</a> to
                let us know about the problem.";
            return true;
        }
        if (!$pswhash) {
            $errFlagged = "An error occurred updating the database. You might
                want to try again - if the problem persists,
                <a href=\"/contact\">contact us</a> to let us know
                about it.";
            return true;
        }
        $activated = $acctstatus == 'D';

        throttle_clear($db, 'login', $usernum);
        throttle_clear($db, 'email', $usernum);

        $loggedIn = $acctstatus == 'A' || $activated;
        if ($loggedIn) {
            record_login($db, $usernum);
            start_login_session($usernum, $pswhash);
        }

        // all is well - start the page
        pageHeader("Password Reset");
?>

<h1>Password Changed</h1>

<p>Your new password is now in effect. Please make a note of it.

<?php
        if ($activated)
            echo "<p>Your new account has also been activated.";
        if ($loggedIn)
            echo "<p>You're now logged in. <a href=\"/index\">Click here</a>
                to go to the IFDB home page.";
        else
            echo "<p><a href=\"login\">Click here</a> to log in.";
?>

<?php

        // no need to show the reset page again
        return false;
    }

    // proceed with displaying the entry form
    return true;
}

