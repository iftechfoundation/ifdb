<?php

include_once "session-start.php";

// make sure we process any persistent login state
include_once "current-user.php";
$curuser = current_user_id();

include_once "dbconnect.php";
$db = dbConnect();

include_once "pagetpl.php";
include_once "util.php";
include "starctl.php";
include_once "rss.php";
include_once "game-rss.php";
include_once "gameinfo.php";
include_once "commentutil.php";
include_once "news.php";
include_once "editgame-util.php";

// get the game ID
$gameid = $_REQUEST['game'] ?? '';
if (!is_string($gameid))
    $gameid = '';

$adminPriv = check_admin_privileges($db, $curuser);

function showResult($title, $msg)
{
    global $gameid, $db;
    mysql_query("unlock tables", $db);
    pageHeader($title);
    echo "<h1>{$title}</h1>"
        . "<p>{$msg}</p>"
        . "<p><a href=\"viewgame?id=" . urlencode($gameid)
        . "&amp;history\">Return to game page</a></p>";
    pageFooter();
    exit();
}

if (!$adminPriv) {
    showResult(
        "Admin authorization required",
        "This function can only be performed by administrators.  Please contact us "
        . "to let us know what you needed to do here and we'll try to assist you.");
}

if ($gameid == "") {
    showResult("Missing game ID", "No game was specified in the request.");
}

if (isset($_POST['confirm'])
    && !mysql_query("lock tables games write, games_history write,
           gamelinks write, ifids write, extreviews write, reviews write,
           gamexrefs write, gameprofilelinks write, users read,
           gamefwds read, gamexreftypes read, filetypes read", $db))
    showResult("Error updating database",
               "The database tables couldn't be locked.");

// look up the game title for the confirmation page
$result = mysqli_execute_query($db,
    "select title, pagevsn, moddate from games where id = ?", [$gameid]);
if (!$result || mysql_num_rows($result) == 0)
    showResult("Game not found", "The specified game wasn't found.");

$title = htmlspecialchars(mysql_result($result, 0, "title"));
$currentVsn = (int)mysql_result($result, 0, "pagevsn");
$currentModDate = mysql_result($result, 0, "moddate");

if (isset($_POST['confirm'])
    && (($_POST['version'] ?? '') !== "$currentVsn"
        || ($_POST['moddate'] ?? '') !== $currentModDate))
    showResult("Listing changed",
               "<i>{$title}</i> was edited since you confirmed, so nothing "
               . "was deleted. Please review the update history and "
               . "try again.");

// query the most recent history entry (required to restore the prior version)
$result = mysqli_execute_query($db,
    "select pagevsn, editedby, moddate, deltas, spam from games_history
     where id = ? order by pagevsn desc", [$gameid]);
if (!$result || mysql_num_rows($result) == 0)
    showResult("No history",
               "This game has no prior version history to restore. "
               . "The current version cannot be deleted.");

$rec = mysql_fetch_array($result, MYSQL_ASSOC);
$pagevsn = $rec['pagevsn'];
$editedby = $rec['editedby'];
$moddate = $rec['moddate'];
$deltas = unserialize($rec['deltas']);
if (!is_array($deltas))
    $deltas = [];

if ($rec['spam'])
    showResult("Version marked as spam",
               "Version {$pagevsn} was marked as spam, so it can't be "
               . "restored as the current version. Roll back to another "
               . "version instead.");

// confirm before deleting
if (!isset($_POST['confirm'])) {
    pageHeader("Delete Game Version");
    echo "<h1>Delete Game Version</h1>"
        . "<p>Permanently delete version {$currentVsn} of "
        . "<i>{$title}</i> and restore version {$pagevsn}?</p>"
        . "<p><b>This cannot be undone.</b> Version {$currentVsn} will be "
        . "removed from the update history. To keep history intact, use "
        . "Roll Back instead.</p>"
        . "<form method=\"post\" action=\"deleteGameVersion\">"
        . "<input type=\"hidden\" name=\"game\" value=\""
        . htmlspecialchars($gameid) . "\">"
        . "<input type=\"hidden\" name=\"version\" value=\"{$currentVsn}\">"
        . "<input type=\"hidden\" name=\"moddate\" value=\""
        . htmlspecialchars($currentModDate) . "\">"
        . "<input type=\"hidden\" name=\"confirm\" value=\"1\">"
        . "<p><button>Yes, permanently delete version {$currentVsn}"
        . "</button></p>"
        . "</form>"
        . "<p><a href=\"viewgame?id=" . urlencode($gameid)
        . "&amp;history\">Cancel</a></p>";
    pageFooter();
    exit();
}

// build the update
$cols = [];
$params = [];
foreach ($deltas as $colname => $colval)
{
    switch ($colname)
    {
    case "links":
    case "ifids":
    case "extreviews":
    case "xrefs":
    case "profileLinks":
        break;

    default:
        // add others to the scalar column list
        $cols[] = "`{$colname}` = ?";
        $params[] = $colval;
        break;
    }
}

$cols[] = "pagevsn = ?";
$params[] = $pagevsn;
$cols[] = "editedby = ?";
$params[] = $editedby;
$cols[] = "moddate = ?";
$params[] = $moddate;

$cols = implode(", ", $cols);
$params[] = $gameid;

// no errors yet
$errors = [];
function addError($desc, $query)
{
    global $errors, $db;
    $errors[] = "<div><span class=\"errmsg\">{$desc}</span>"
                .   "<div class=\"indented\">"
                .     "<p>Query: " . htmlspecialchars($query) . "</p>"
                .     "<p>Error: ". htmlspecialchars(mysql_error($db)) . "</p>"
                .   "</div>"
                . "</div>";
}
function runQuery($desc, $query, $params = [])
{
    global $db;
    if (!mysqli_execute_query($db, $query, $params))
        addError($desc, $query);
}

// execute the update
runQuery("Game record update", "update games set $cols where id = ?", $params);

// update IFIDs
if (isset($deltas["ifids"])) {
    runQuery("Deleting old IFIDs", "delete from ifids where gameid = ?", [$gameid]);

    foreach ($deltas["ifids"] as $ifid) {
        runQuery("Inserting new IFID",
                 "insert into ifids (gameid, ifid) values (?, ?)",
                 [$gameid, strtoupper($ifid)]);
    }
}

// update links
if (isset($deltas["links"])) {
    $links = $deltas["links"];
    runQuery("Deleting old game links", "delete from gamelinks where gameid = ?", [$gameid]);
    for ($i = 0; $i < count($links); $i++) {
        if (!insert_gamelink($db, $gameid, $links[$i], $i))
            addError("Inserting gamelink", "insert_gamelink({$links[$i]}, {$i})");
    }
}

// update external review links
if (isset($deltas["extreviews"])) {
    $revs = $deltas['extreviews'];
    runQuery("Deleting old external review links", "delete from extreviews where gameid = ?", [$gameid]);
    runQuery("Deleting old external reviews", "delete from reviews where gameid = ? and special='4'", [$gameid]);
    for ($i = 0 ; $i < count($revs) ; $i++) {
        if (!insert_extrev($db, $gameid, $revs[$i], $i))
            addError("Inserting external review link", "insert_extrev({$revs[$i]}, {$i})");
    }
}

if (isset($deltas["profileLinks"])) {
    $progress = false;
    $pl = $deltas["profileLinks"];
    if (!update_profile_links($db, $gameid, $pl, $progress))
        addError("Updating profile links", "update_profile_links([" . implode(",", $pl) . "]) : {$progress}");
}

// update cross-references
if (isset($deltas["xrefs"])) {
    $xrefs = $deltas["xrefs"];
    runQuery("Deleting old xrefs", "delete from gamexrefs where fromid = ?", [$gameid]);
    for ($i = 0 ; $i < count($xrefs); $i++) {
        if (!insert_xref($db, $gameid, $xrefs[$i], $i))
            addError("Inserting xref", "insert_xref({$xrefs[$i]}, {$i})");
    }
}

// delete the version
if (count($errors) == 0)
    runQuery("Deleting version history record", "delete from games_history where id = ? and pagevsn = ?", [$gameid, $pagevsn]);
else
    $errors[] = "<div>Note: errors occurred deleting game version; version history record was not deleted</div>";

// unlock tables
runQuery("Unlocking tables", "unlock tables");

// show errors
if (count($errors))
    showResult("Error updating database", implode("", $errors));

// success
    showResult("Success", "Game version successfully deleted.");
?>
